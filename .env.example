# MongoDB Atlas connection string (the free M0 plan works)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/boda?retryWrites=true&w=majority

# Admin dashboard credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
JWT_SECRET=replace-with-at-least-32-random-characters

# URLs used during development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Replace this with your final YouTube upload ID
VITE_YOUTUBE_VIDEO_ID=aqz-KE-bpKQ
VITE_YOUTUBE_START_SECONDS=0
VITE_WEDDING_DATE=2026-11-14
VITE_WEDDING_IMAGE_URL=
# Leave empty when the API and website use the same domain.
VITE_API_URL=
